<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Painel Administrativo — Raipédia</title>

  <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

  <header class="admin-header">

    <div class="admin-header-content">
      <h1>Painel Administrativo</h1>

      <a href="/logout" class="btn btn-secondary">
        Sair
      </a>
    </div>

  </header>


  <main class="admin-container">

    <div class="admin-grid">


      <!-- INÍCIO -->
      <div class="card">
        <h2>Início</h2>

        <p>
          Gerenciar os conteúdos da página inicial da Raipédia.
        </p>

        <a href="/admin/inicio" class="btn btn-primary">
          Gerenciar
        </a>
      </div>


      <!-- CAPACITAÇÕES -->
      <div class="card">
        <h2>Capacitações</h2>

        <p>
          Gerenciar as capacitações disponibilizadas pela Raipédia.
        </p>

        <a href="/admin/capacitacoes" class="btn btn-primary">
          Gerenciar
        </a>
      </div>

      <!-- ARTIGOS -->
      <div class="card">
        <h2>Artigos</h2>

        <p>
          Criar, editar e remover artigos da Raipédia.
        </p>

        <a href="/admin/artigos" class="btn btn-primary">
          Gerenciar
        </a>
      </div>


      <!-- CONTEÚDOS -->
      <div class="card">
        <h2>Conteúdos</h2>

        <p>
          Gerenciar materiais e conteúdos educacionais.
        </p>

        <a href="/admin/conteudos" class="btn btn-primary">
          Gerenciar
        </a>
      </div>


      <!-- CATEGORIAS -->
      <div class="card">
        <h2>Categorias</h2>

        <p>
          Gerenciar e organizar as categorias dos conteúdos.
        </p>

        <a href="/admin/categorias" class="btn btn-primary">
          Gerenciar
        </a>
      </div>


      <!-- AUTORES -->
      <div class="card">
        <h2>Autores</h2>

        <p>
          Gerenciar os autores dos conteúdos publicados.
        </p>

        <a href="/admin/autores" class="btn btn-primary">
          Gerenciar
        </a>
      </div>


      <!-- DESTAQUES -->
      <div class="card">
        <h2>Destaques</h2>

        <p>
          Gerenciar os conteúdos exibidos em destaque.
        </p>

        <a href="/admin/destaques" class="btn btn-primary">
          Gerenciar
        </a>
      </div>


      <!-- MÓDULOS -->
      <div class="card">
        <h2>Módulos</h2>

        <p>
          Gerenciar a estrutura dos módulos educacionais.
        </p>

        <a href="/admin/modulos" class="btn btn-primary">
          Gerenciar
        </a>
      </div>


      <!-- USUÁRIOS -->
      <div class="card">
        <h2>Usuários</h2>

        <p>
          Gerenciar usuários com acesso administrativo.
        </p>

        <a href="/admin/usuarios" class="btn btn-primary">
          Gerenciar
        </a>
      </div>

    </div>

  </main>

</body>

</html>

